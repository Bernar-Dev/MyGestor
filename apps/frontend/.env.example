# ─── Supabase (auth + banco) ───────────────────────────────────────────
# Pegue em https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Criptografia (32 bytes em base64) ─────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=GENERATE_ME

# ─── App ───────────────────────────────────────────────────────────────
# URL pública da aplicação (sem barra no final). Em dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── API (NestJS) ──────────────────────────────────────────────────────
# URL do backend NestJS. Em dev: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
